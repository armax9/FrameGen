#!/bin/zsh -f
set -eu

fail() { print -u2 -r -- "$1"; exit 1; }
line() { [[ "$1" != *[$'\t\r\n']* ]]; }

resources=${0:A:h}
crossover_home="$HOME/Library/Application Support/CrossOver"
moltenvr_home="$HOME/Library/Application Support/MoltenVR"
runtime_key='HKLM\Software\Khronos\OpenXR\1'
implicit_key="$runtime_key\ApiLayers\Implicit"
win_manifest='C:\FrameGen\FrameGen.json'
layer_name='XR_APILAYER_ARMAX_framegen'

crossovers() {
  local directory app wine_path
  for directory in /Applications "$HOME/Applications"; do
    for app in "$directory/CrossOver.app" "$directory/CrossOver Preview.app"; do
      wine_path="$app/Contents/SharedSupport/CrossOver/bin/wine"
      if [[ -x "$wine_path" ]]; then print -r -- "$app"; fi
    done
  done
}

typeset -aU crossover_roots
configured_roots=${CX_BOTTLE_PATH:-}
if [[ -z "$configured_roots" && -r "$crossover_home/CrossOver.conf" ]]; then
  configured_roots=$(/usr/bin/awk '
    /^\[/ { cross_over = ($0 == "[CrossOver]") }
    cross_over && /^"BottlePath"[[:space:]]*=/ {
      sub(/^[^=]*=[[:space:]]*"/, ""); sub(/"[[:space:]]*$/, ""); print; exit
    }' "$crossover_home/CrossOver.conf")
fi
crossover_roots=("${(@s.:.)configured_roots}" "$crossover_home/Bottles")

valid_bottle() {
  [[ -d "$2/drive_c" ]] || return 1
  case "$1" in
    crossover) [[ -r "$2/cxbottle.conf" ]] ;;
    moltenvr) [[ -r "$2/system.reg" && ! -e "$2/cxbottle.conf" ]] ;;
  esac
}

moltenvr_external_roots() {
  local domain data path index
  for domain in dev.moltenvr.preview dev.moltenvr.app; do
    data=$(/usr/bin/plutil -extract extraBottleDirs raw -o - \
      "$HOME/Library/Preferences/$domain.plist" 2>/dev/null | /usr/bin/base64 -D) || continue
    [[ -n "$data" ]] || continue
    index=0
    while path=$(print -r -- "$data" | /usr/bin/plutil -extract "$index" raw -expect string -o - - 2>/dev/null); do
      if [[ "$path" == /* ]] && line "$path"; then print -r -- "$path"; fi
      index=$(( index + 1 ))
    done
  done
}

list_bottles() {
  local kind=$1 include_provider=${2:-0} root entry name canonical key
  local -a roots
  typeset -A seen
  if [[ "$kind" == crossover ]]; then
    roots=("${crossover_roots[@]}")
  else
    roots=("$moltenvr_home/Bottles" "${(@f)$(moltenvr_external_roots)}")
  fi
  for root in "${roots[@]}"; do
    [[ "$root" == /* && -d "$root" ]] || continue
    for entry in "$root"/*(N); do
      name=${entry:t}
      valid_bottle "$kind" "$entry" || continue
      canonical=${entry:A}
      line "$name" && line "$canonical" || continue
      key=$name
      if [[ "$kind" == moltenvr ]]; then key=$canonical; fi
      [[ -z ${seen[$key]:-} ]] || continue
      seen[$key]=1
      if (( include_provider )) && [[ "$kind" == moltenvr ]]; then
        printf '%s\t%s\t%s\n' "$kind" "$name" "$canonical"
      elif (( include_provider )); then
        printf '%s\t%s\n' "$kind" "$name"
      else
        print -r -- "$name"
      fi
    done
  done
}

bottles() {
  if [[ "$provider" == all ]]; then
    list_bottles crossover 1
    list_bottles moltenvr 1
  else
    list_bottles "$provider"
  fi
}

select_bottle() {
  local root match='' kind name path
  [[ "$provider" != all ]] || fail 'Select a single bottle provider.'
  if [[ -n "$bottle_path" ]]; then
    [[ "$provider" == moltenvr && "$bottle_path" == /* ]] && line "$bottle_path" &&
      valid_bottle moltenvr "$bottle_path" || fail 'MoltenVR bottle folder is unavailable.'
    prefix=${bottle_path:A}
    target="$prefix/drive_c/FrameGen"
    return
  fi
  [[ -n "$bottle" && "$bottle" != */* && "$bottle" != . && "$bottle" != .. ]] && line "$bottle" ||
    fail 'Select a bottle.'
  if [[ "$provider" == moltenvr ]]; then
    while IFS=$'\t' read -r kind name path; do
      [[ "$name" == "$bottle" ]] || continue
      [[ -z "$match" ]] || fail "Multiple MoltenVR bottles are named $bottle. Select one by path."
      match=$path
    done < <(list_bottles moltenvr 1)
    if [[ -n "$match" ]]; then
      prefix=$match
      target="$prefix/drive_c/FrameGen"
      return
    fi
    fail "Bottle not found ($provider): $bottle"
  fi
  for root in "${crossover_roots[@]}"; do
    if [[ "$root" == /* ]] && valid_bottle "$provider" "$root/$bottle"; then
      prefix=${root%/}/$bottle
      prefix=${prefix:A}
      target="$prefix/drive_c/FrameGen"
      return
    fi
  done
  fail "Bottle not found ($provider): $bottle"
}

select_wine() {
  local chosen candidate domain runner
  if [[ "$provider" == moltenvr ]]; then
    local -a configured
    for domain in dev.moltenvr.preview dev.moltenvr.app; do
      candidate=$(/usr/bin/plutil -extract winePath raw -expect string -o - \
        "$HOME/Library/Preferences/$domain.plist" 2>/dev/null) || continue
      configured+=("$candidate")
    done
    configured+=("$moltenvr_home/wine/Libraries/Wine/bin/wine64" "$moltenvr_home/wine/Libraries/Wine/bin/wine"
      "$moltenvr_home/wine-d3dmetal/bin/wine64" "$moltenvr_home/wine-d3dmetal/bin/wine")
    runner=''
    if [[ -r "$prefix/.moltenvr_wine" ]]; then runner=$(<"$prefix/.moltenvr_wine"); fi
    if [[ "$runner" != /* || ! -x "$runner" ]]; then runner=''; fi
    for candidate in "${configured[@]}"; do
      line "$candidate" && [[ "$candidate" == /* && -x "$candidate" ]] || continue
      if [[ -n "$runner" && "${runner:A}" != "${candidate:A}" ]]; then continue; fi
      wine=$candidate
      wineserver="${wine:h}/wineserver"
      if [[ -x "$wineserver" ]]; then return 0; fi
    done
    fail 'MoltenVR Wine is unavailable for this bottle. Check the Wine path in MoltenVR settings.'
  fi
  if [[ -z "$crossover" ]]; then
    chosen=$(crossovers)
    crossover=${chosen%%$'\n'*}
  fi
  [[ "$crossover" == /*.app ]] || fail 'CrossOver or CrossOver Preview was not found.'
  wine="$crossover/Contents/SharedSupport/CrossOver/bin/wine"
  [[ -x "$wine" ]] || fail "CrossOver executable not found in $crossover."
}

reg() (
  unset WINEDLLOVERRIDES
  if [[ "$provider" == moltenvr ]]; then
    unset WINEARCH WINELOADER WINEDLLPATH
    WINEPREFIX="$prefix" WINESERVER="$wineserver" WINEDEBUG=-all "$wine" reg.exe "$@"
  else
    "$wine" --bottle "$prefix" --scope private reg.exe "$@"
  fi
)

prepare_layout() {
  local directory
  for directory in "$target" "$target/status"; do
    [[ ! -L "$directory" ]] || fail "Unexpected symbolic link: $directory"
    /bin/mkdir -p "$directory"
  done
  [[ ! -L "$target/.ctl.lock" ]] || fail 'Unexpected FrameGen lock link.'
  zmodload zsh/system
  /usr/bin/touch "$target/.ctl.lock"
  zsystem flock -t 10 "$target/.ctl.lock" || fail 'Another FrameGen change is in progress.'
}

manifest_owned() {
  [[ -f "$1" && ! -L "$1" ]] &&
    [[ $(/usr/bin/plutil -extract api_layer.name raw -o - "$1" 2>/dev/null) == "$layer_name" ]]
}

manifest_version() {
  local value
  value=$(/usr/bin/plutil -extract api_layer.implementation_version raw -o - "$1" 2>/dev/null) &&
    [[ "$value" =~ '^[1-9][0-9]*$' ]] || return 1
  print -r -- "$value"
}

registry_enabled() {
  [[ -r "$prefix/system.reg" ]] || return 1
  /usr/bin/awk '
    /^\[/ {
      implicit = (tolower($1) == "[software\\\\khronos\\\\openxr\\\\1\\\\apilayers\\\\implicit]")
    }
    implicit && tolower($0) == "\"c:\\\\framegen\\\\framegen.json\"=dword:00000000" {
      found = 1
      exit
    }
    END { exit !found }
  ' "$prefix/system.reg"
}

install_layer() (
  manifest_owned "$resources/FrameGen.json" && [[ -f "$resources/FrameGen.dll" ]] ||
    fail 'This app is missing its FrameGen layer payload.'
  local files_only=${1:-0}
  if (( files_only )) && ! registry_enabled; then
    fail 'FrameGen must already be registered to update without starting Wine.'
  fi
  prepare_layout
  if [[ -e "$target/FrameGen.json" || -e "$target/FrameGen.dll" ||
        -L "$target/FrameGen.json" || -L "$target/FrameGen.dll" ]]; then
    manifest_owned "$target/FrameGen.json" &&
      [[ ! -L "$target/FrameGen.dll" && ( ! -e "$target/FrameGen.dll" || -f "$target/FrameGen.dll" ) ]] ||
      fail 'C:\FrameGen already contains an unrelated layer. Existing files were preserved.'
  fi
  local stage previous previous_value='' item replacing=0 registration_attempted=0 committed=0 registered=0
  if registry_enabled; then
    registered=1
  elif (( files_only )); then
    fail 'The FrameGen registration changed during the update.'
  else
    select_wine
  fi
  stage=$(/usr/bin/mktemp -d "$target/.install.XXXXXX")
  cleanup_install() {
    local result=$? file
    trap - EXIT
    if (( ! committed )); then
      if (( registration_attempted )); then
        if [[ -n "$previous_value" ]]; then
          reg add "$implicit_key" /v "$win_manifest" /t REG_DWORD /d "$previous_value" /f >/dev/null ||
            print -u2 -r -- 'Could not restore the previous FrameGen registry value.'
        else
          reg delete "$implicit_key" /v "$win_manifest" /f >/dev/null 2>&1 || true
        fi
      fi
      if (( replacing )); then
        for file in FrameGen.dll FrameGen.json; do
          if [[ -f "$stage/prior-$file" ]]; then
            /bin/mv -f "$stage/prior-$file" "$target/$file" ||
              print -u2 -r -- "Could not restore $file from $stage."
          else
            /bin/rm -f "$target/$file"
          fi
        done
      fi
    fi
    if (( committed || ! replacing )) || [[ ! -e "$stage/prior-FrameGen.dll" && ! -e "$stage/prior-FrameGen.json" ]]; then
      /bin/rm -rf "$stage"
    fi
    exit "$result"
  }
  trap cleanup_install EXIT
  trap 'exit 130' INT
  trap 'exit 143' TERM
  for item in FrameGen.dll FrameGen.json; do
    /usr/bin/install -m 0644 "$resources/$item" "$stage/$item"
    if [[ -f "$target/$item" ]]; then /bin/cp -p "$target/$item" "$stage/prior-$item"; fi
  done
  if (( ! registered )) && previous=$(reg query "$implicit_key" /v "$win_manifest" 2>/dev/null); then
    previous_value=$(print -r -- "$previous" | /usr/bin/awk '/REG_DWORD/ { sub(/\r$/, ""); print $NF; exit }')
    [[ "$previous_value" =~ '^(0x[0-9a-fA-F]+|[0-9]+)$' ]] ||
      fail 'An incompatible FrameGen registry value already exists.'
  fi
  replacing=1
  /bin/mv -f "$stage/FrameGen.dll" "$target/FrameGen.dll"
  /bin/mv -f "$stage/FrameGen.json" "$target/FrameGen.json"
  if (( ! registered )); then
    registration_attempted=1
    reg add "$implicit_key" /v "$win_manifest" /t REG_DWORD /d 0 /f >/dev/null ||
      fail 'Could not register the implicit OpenXR layer.'
    previous=$(reg query "$implicit_key" /v "$win_manifest") ||
      fail 'Could not verify the OpenXR registration.'
    previous=$(print -r -- "$previous" | /usr/bin/awk '/REG_DWORD/ { sub(/\r$/, ""); print $NF; exit }')
    [[ "$previous" =~ '^(0x)?0+$' ]] || fail 'Could not verify the enabled OpenXR registration.'
  fi
  committed=1
  print -r -- "FrameGen installed in $bottle."
)

write_atomic() {
  local destination=$1 content=$2 temp
  [[ ! -L "$destination" && ! -d "$destination" ]] || fail "Unexpected FrameGen file: $destination"
  temp=$(/usr/bin/mktemp "${destination:h}/.write.XXXXXX")
  if ! printf '%s' "$content" > "$temp" || ! /bin/mv -f "$temp" "$destination"; then
    /bin/rm -f "$temp"
    fail "Could not save $destination."
  fi
}

read_installation() {
  local manifest="$target/FrameGen.json" library="$target/FrameGen.dll" registered=0
  installation=partial installed_version=-
  bundled_version=$(manifest_version "$resources/FrameGen.json") ||
    fail 'This app is missing its FrameGen manifest version.'
  if registry_enabled; then registered=1; fi
  if [[ ! -e "$manifest" && ! -L "$manifest" && ! -e "$library" && ! -L "$library" ]] &&
      (( ! registered )); then
    installation=missing
    return
  fi
  if manifest_owned "$manifest"; then
    installed_version=$(manifest_version "$manifest") || installed_version=-
  fi
  [[ "$installed_version" != - && -f "$library" && ! -L "$library" ]] && (( registered )) ||
    return 0
  if [[ "$installed_version" != "$bundled_version" ]]; then
    installation=outdated
  elif /usr/bin/cmp -s "$manifest" "$resources/FrameGen.json" &&
       /usr/bin/cmp -s "$library" "$resources/FrameGen.dll"; then
    installation=current
  fi
}

read_mode() {
  mode=off
  local value
  [[ -f "$target/mode.txt" && ! -L "$target/mode.txt" ]] || return 0
  value=$(<"$target/mode.txt") || return 0
  if [[ "${value%$'\r'}" == on ]]; then mode=on; fi
}

read_activity() {
  read_mode
  runtime_state=idle game=- runtime_issue=-
  [[ -d "$target/status" && ! -L "$target/status" ]] || return 0
  zmodload zsh/datetime
  zmodload zsh/stat
  local status_file pid session_file state name issue extra stamp newest=-1
  local -a times
  local -A states names issues stamps
  local -i now=$EPOCHSECONDS
  for status_file in "$target/status/"*.txt(N.); do
    session_file=${status_file:t:r}
    [[ "$session_file" =~ '^[1-9][0-9]*(-[0-9]+)?$' ]] || continue
    zstat -A times +mtime -- "$status_file" 2>/dev/null || continue
    stamp=${times[1]}
    (( stamp >= now - 3 && stamp <= now + 1 )) || continue
    IFS=$'\t' read -r pid state name issue extra < "$status_file" 2>/dev/null || continue
    [[ "$pid" == "${session_file%%-*}" && -n "$name" && -z "$extra" ]] && line "$name" || continue
    [[ -z "$issue" || "$issue" =~ '^[a-z][a-z-]*:-?[0-9]+$' ]] || continue
    case "$state" in active|waiting|unsupported|unsupported-d3d12|off) ;; *) continue ;; esac
    if [[ ${states[$pid]:-} == active && "$state" != active ]]; then continue; fi
    if [[ "${states[$pid]:-}" == "$state" ]] && (( stamp < ${stamps[$pid]:--1} )); then continue; fi
    if [[ "$state" != active ]] && (( stamp < ${stamps[$pid]:--1} )); then continue; fi
    states[$pid]=$state names[$pid]=$name issues[$pid]=${issue:--} stamps[$pid]=$stamp
  done
  for pid in "${(@k)states}"; do
    stamp=${stamps[$pid]}
    (( stamp >= newest )) || continue
    if (( stamp == newest )) && [[ "$runtime_state" == active ]]; then continue; fi
    newest=$stamp runtime_state=${states[$pid]} game=${names[$pid]} runtime_issue=${issues[$pid]}
  done
}

operation=${1:-}
[[ -n "$operation" ]] || fail 'Choose a FrameGen command.'
shift
bottle='' bottle_path='' crossover='' requested_mode='' provider=crossover
while (( $# )); do
  (( $# >= 2 )) || fail "Missing value for $1."
  case "$1" in
    --bottle) bottle=$2 ;;
    --bottle-path) bottle_path=$2 ;;
    --crossover) crossover=$2 ;;
    --provider) provider=$2 ;;
    --mode) requested_mode=$2 ;;
    *) fail "Unknown option: $1" ;;
  esac
  shift 2
done

case "$provider" in
  crossover|moltenvr) ;;
  all) [[ "$operation" == bottles ]] || fail 'Select a single bottle provider.' ;;
  *) fail "Unknown bottle provider: $provider" ;;
esac

case "$operation" in
  bottles) bottles ;;
  crossovers) crossovers ;;
  install) select_bottle; install_layer ;;
  update-files) select_bottle; install_layer 1 ;;
  status)
    select_bottle
    read_installation
    read_activity
    printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\n' "$installation" "$mode" "$runtime_state" "$game" "$installed_version" "$bundled_version" "$runtime_issue"
    ;;
  activity)
    select_bottle
    read_activity
    printf '%s\t%s\t%s\t%s\n' "$mode" "$runtime_state" "$game" "$runtime_issue"
    ;;
  mode)
    select_bottle
    [[ "$requested_mode" == on || "$requested_mode" == off ]] || fail 'Choose FrameGen on or off.'
    prepare_layout
    read_installation
    [[ "$installation" == current ]] || fail "Install the current FrameGen version in $bottle first."
    write_atomic "$target/mode.txt" "$requested_mode"
    print -r -- "$requested_mode"
    ;;
  *) fail "Unknown command: $operation" ;;
esac
